# MYBF Platform - Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mybf_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mybf_platform?schema=public"

# App & Authentication
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="mybf-enterprise-platform-secure-jwt-session-secret-key-32chars"

# Digital ID Card Cryptographic Signing
ID_CARD_SIGNING_SECRET="mybf-id-card-qr-hmac-sha256-verification-secret-production"

# Payment Gateway (Razorpay India / Test mode)
RAZORPAY_KEY_ID="rzp_test_dummy_key"
RAZORPAY_KEY_SECRET="rzp_test_dummy_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret"

# Redis & Background Workers
REDIS_URL="redis://localhost:6379"

# Object Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="mybf-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
